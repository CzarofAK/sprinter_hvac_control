# Kopiere diese Datei nach secrets.yaml und trage echte Werte ein.
# secrets.yaml ist in .gitignore und wird NICHT committet.

# Wi-Fi Zugangsdaten
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# HomeAssistant API Verschlüsselung (in ESPHome erzeugen/kopieren)
api_encryption_key: "BASE64_32_BYTE_KEY_FROM_ESPHOME"

# OTA- / Legacy-API-Passwort (siehe ota: in .basics.yaml)
password: "OTA_AND_LEGACY_API_PASSWORD"

# Passwort des Fallback-Access-Points, falls kein WLAN gefunden wird
fallback_password: "FALLBACK_AP_PASSWORD_MIN_8_CHARS"
