# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is in .gitignore and is NOT committed.

# Wi-Fi credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# HomeAssistant API encryption key (generate/copy from ESPHome)
api_encryption_key: "BASE64_32_BYTE_KEY_FROM_ESPHOME"

# OTA / legacy API password (see ota: in .basics.yaml)
password: "OTA_AND_LEGACY_API_PASSWORD"

# Password for the fallback access point if no WiFi network is found
fallback_password: "FALLBACK_AP_PASSWORD_MIN_8_CHARS"
